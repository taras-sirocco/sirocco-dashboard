DATABASE_URL=postgres://postgres@127.0.0.1:5432/sirocco
PAYLOAD_SECRET=YOUR_SECRET_HERE
APP_SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# Вихідні Slack-сповіщення (App → Slack). Якщо не задано — сповіщення
# відповідного каналу тихо пропускається (лог warn), нічого не ламається.
SLACK_WEBHOOK_URL_CRITICAL=YOUR_INCOMING_WEBHOOK_FOR_PROD_CRITICAL
SLACK_WEBHOOK_URL_REPORTS=YOUR_INCOMING_WEBHOOK_FOR_PROD_REPORTS
# Кома-розділені Slack member ID у форматі <@ID>, напр. <@U0123ABC>,<@U0456DEF>.
# Порожньо → фолбек на <!channel> у критичних сповіщеннях.
SLACK_CRITICAL_MENTIONS=
